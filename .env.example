# Application Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
# For Docker: use 'mysql' as host, for local: use 'localhost'
DATABASE_URL=mysql://root:root@mysql:3306/note_taker_db
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=note_taker_db
DATABASE_HOST=mysql
DATABASE_PORT=3306

# Redis Configuration
# For Docker: use 'redis' as host, for local: use 'localhost'
REDIS_URL=redis://redis:6379

# JWT Configuration
# Generate secure random strings for production
# You can generate using: openssl rand -hex 64
JWT_ACCESS_KEY_SECRET=jwt-access-secret
JWT_REFRESH_KEY_SECRET=jwt-refresh-secret

# CORS Configuration
CORS_ORIGIN=*
