generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  id            Int            @unique @default(autoincrement())
  firstName     String
  lastName      String
  phoneNumber   String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  modifiedAt    DateTime       @default(now()) @updatedAt
  status        user_status    @default(ENABLED)
  user_sessions user_session[]
  notes         note[]         @relation("OwnedNotes")
  sharedByMe    note_share[]   @relation("SharedByUser")
  sharedWithMe  note_share[]   @relation("SharedWithUser")
}

model user_session {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  user         user     @relation(fields: [userId], references: [id])
}

enum user_status {
  ENABLED
  DISABLED
}

enum share_permission {
  READ
  EDIT
}

model note {
  id        String         @id @default(uuid())
  title     String         @db.VarChar(255)
  content   String         @db.Text
  version   Int            @default(1)
  isDeleted Boolean        @default(false)
  deletedAt DateTime?
  userId    Int
  user      user           @relation("OwnedNotes", fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  versions  note_version[]
  shares    note_share[]

  @@index([userId])
  @@index([isDeleted])
  @@index([userId, isDeleted])
  @@fulltext([title, content])
}

model note_version {
  id                String   @id @default(uuid())
  noteId            String
  title             String   @db.VarChar(255)
  content           String   @db.Text
  versionNumber     Int
  createdAt         DateTime @default(now())
  createdBy         Int
  changeDescription String?  @db.VarChar(500)
  note              note     @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([noteId])
  @@index([noteId, versionNumber])
  @@index([createdAt])
}

model note_share {
  id           String           @id @default(uuid())
  noteId       String
  sharedBy     Int
  sharedWith   Int
  permission   share_permission @default(READ)
  isRevoked    Boolean          @default(false)
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  note         note             @relation(fields: [noteId], references: [id], onDelete: Cascade)
  owner        user             @relation("SharedByUser", fields: [sharedBy], references: [id])
  collaborator user             @relation("SharedWithUser", fields: [sharedWith], references: [id])

  @@unique([noteId, sharedWith])
  @@index([noteId, isRevoked])
  @@index([sharedWith, isRevoked])
}
